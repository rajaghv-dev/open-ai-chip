# Local precheck runtime: Ubuntu 22.04 (aarch64) + magic/netgen from the pinned LibreLane 3.0.2 image
# + klayout (see below) + cvc_rv (OEB/ERC) built from source + cf-precheck 1.3.7 in a venv.
# No account access, no uploads; only public package/source downloads.
FROM ubuntu:22.04 AS cvc
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y build-essential git ca-certificates autoconf automake libtool gettext autopoint bison flex m4 libboost-all-dev zlib1g-dev pkg-config libreadline-dev && rm -rf /var/lib/apt/lists/*
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG CVC_REF=master
RUN git clone https://github.com/d-m-bailey/cvc.git /src/cvc && cd /src/cvc && git checkout ${CVC_REF} \
 && autoreconf -i && ./configure --prefix=/opt/cvc && make && make install \
 && git -C /src/cvc rev-parse HEAD > /opt/cvc/COMMIT

FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive QT_QPA_PLATFORM=offscreen
RUN apt-get update && apt-get install -y --no-install-recommends make gawk sed perl ruby python3 python3-venv python3-pip libexpat1 zlib1g libcurl4 libgomp1 libgit2-1.1 libboost-iostreams1.74.0 ca-certificates git csh iverilog tcl8.6 libreadline8 libqt5core5a libqt5gui5 libqt5widgets5 libqt5xml5 libqt5xmlpatterns5 libqt5sql5 libqt5network5 libqt5printsupport5 libqt5svg5 libqt5multimedia5 libqt5multimediawidgets5 libqt5designer5 libpython3.10 libruby3.0 && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/librelane/librelane:3.0.2 /nix /nix
COPY --from=cvc /opt/cvc /opt/cvc
RUN for t in magic netgen; do ln -sf "$(ls -d /nix/store/*-${t}-*/bin/${t} | head -1)" /usr/local/bin/$t; done \
 && ln -sf /opt/cvc/bin/cvc_rv /usr/local/bin/cvc_rv
# FALLBACK: klayout 0.30.7 from the LibreLane image instead of the pinned 0.29.12
RUN ln -sf "$(ls -d /nix/store/*-klayout-0.30.7/bin/klayout | head -1)" /usr/local/bin/klayout
# cf-precheck pins klayout==0.29.12 but PyPI has no aarch64 wheel for it (first aarch64 wheel is 0.30.2), so install
# cf-precheck --no-deps and use the closest klayout python module (pya) available for aarch64.
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -U pip \
 && /opt/venv/bin/pip install --no-cache-dir --no-deps cf-precheck==1.3.7 \
 && /opt/venv/bin/pip install --no-cache-dir --only-binary=klayout klayout==0.30.7 numpy pyverilog pyyaml requests rich strsimpy
ENV PATH=/opt/venv/bin:$PATH
