{
    "//1": "Design files",
    "PDK": "sky130A",
    "STD_CELL_LIBRARY": "sky130_fd_sc_hd",
    "VERILOG_FILES": [
        "dir::rtl/defines.v",
        "dir::rtl/user_project_wrapper.v"
    ],
    "PNR_SDC_FILE": "dir::signoff.sdc",
    "//2": "Hardening strategy variables (1-Macro-First hardening, as in the ChipFoundry template)",
    "SYNTH_ELABORATE_ONLY": true,
    "RUN_POST_GPL_DESIGN_REPAIR": false,
    "RUN_POST_CTS_RESIZER_TIMING": false,
    "DESIGN_REPAIR_BUFFER_INPUT_PORTS": false,
    "PDN_ENABLE_RAILS": false,
    "RUN_ANTENNA_REPAIR": false,
    "RUN_FILL_INSERTION": false,
    "RUN_TAP_ENDCAP_INSERTION": false,
    "RUN_CTS": false,
    "RUN_IRDROP_REPORT": false,
    "ERROR_ON_SYNTH_CHECKS": false,
    "//3": "Macros: the one hardened tiny_ai_core, views exported by 'make views DESIGN=tiny_ai_core'",
    "MACROS": {
        "tiny_ai_core": {
            "gds": [
                "dir::../../build/macros/tiny_ai_core/gds/tiny_ai_core.gds"
            ],
            "lef": [
                "dir::../../build/macros/tiny_ai_core/lef/tiny_ai_core.lef"
            ],
            "instances": {
                "mprj": {
                    "location": [
                        189.06,
                        87.04
                    ],
                    "orientation": "N"
                }
            },
            "nl": [
                "dir::../../build/macros/tiny_ai_core/nl/tiny_ai_core.nl.v"
            ],
            "pnl": [
                "dir::../../build/macros/tiny_ai_core/pnl/tiny_ai_core.pnl.v"
            ],
            "spef": {
                "min_*": [
                    "dir::../../build/macros/tiny_ai_core/spef/min/tiny_ai_core.min.spef"
                ],
                "nom_*": [
                    "dir::../../build/macros/tiny_ai_core/spef/nom/tiny_ai_core.nom.spef"
                ],
                "max_*": [
                    "dir::../../build/macros/tiny_ai_core/spef/max/tiny_ai_core.max.spef"
                ]
            },
            "lib": {
                "*_tt_*": "dir::../../build/macros/tiny_ai_core/lib/nom_tt_025C_1v80/tiny_ai_core__nom_tt_025C_1v80.lib",
                "*_ss_*": "dir::../../build/macros/tiny_ai_core/lib/nom_ss_100C_1v60/tiny_ai_core__nom_ss_100C_1v60.lib",
                "*_ff_*": "dir::../../build/macros/tiny_ai_core/lib/nom_ff_n40C_1v95/tiny_ai_core__nom_ff_n40C_1v95.lib"
            }
        }
    },
    "PDN_MACRO_CONNECTIONS": [
        "mprj vccd1 vssd1 vccd1 vssd1"
    ],
    "//4": "PDN configurations (template values)",
    "PDN_VOFFSET": 5,
    "PDN_HOFFSET": 5,
    "PDN_VWIDTH": 3.1,
    "PDN_HWIDTH": 3.1,
    "PDN_VSPACING": 15.5,
    "PDN_HSPACING": 15.5,
    "PDN_VPITCH": 180,
    "PDN_HPITCH": 180,
    "ERROR_ON_PDN_VIOLATIONS": false,
    "//5": "Magic variables",
    "MAGIC_DRC_USE_GDS": true,
    "DRT_THREADS": 1,
    "MAX_TRANSITION_CONSTRAINT": 1.5,
    "//6": "Fixed configurations for caravel. You should NOT edit this section (PDN_* names are the LibreLane 3 spelling of the template's FP_PDN_* keys)",
    "DESIGN_NAME": "user_project_wrapper",
    "FP_SIZING": "absolute",
    "DIE_AREA": [
        0,
        0,
        2920,
        3520
    ],
    "FP_DEF_TEMPLATE": "dir::fixed_dont_change/user_project_wrapper.def",
    "VDD_NETS": [
        "vccd1",
        "vccd2",
        "vdda1",
        "vdda2"
    ],
    "GND_NETS": [
        "vssd1",
        "vssd2",
        "vssa1",
        "vssa2"
    ],
    "PDN_CORE_RING": true,
    "PDN_CORE_RING_VWIDTH": 3.1,
    "PDN_CORE_RING_HWIDTH": 3.1,
    "PDN_CORE_RING_VOFFSET": 12.45,
    "PDN_CORE_RING_HOFFSET": 12.45,
    "PDN_CORE_RING_VSPACING": 1.7,
    "PDN_CORE_RING_HSPACING": 1.7,
    "CLOCK_PORT": "wb_clk_i",
    "SIGNOFF_SDC_FILE": "dir::signoff.sdc",
    "MAGIC_DEF_LABELS": false,
    "CLOCK_PERIOD": 25,
    "MAGIC_ZEROIZE_ORIGIN": false,
    "meta": {
        "version": 2
    }
}
