  {
   "id": 7,
   "title": "All designs",
   "type": "table",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "chipdb"
   },
   "description": "Source: designs/*/output/{metrics,resources}.json, designs/FROZEN.json (make grafana-db).",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "chipdb"
     },
     "queryText": "SELECT name, family, cells, ff, die_um2, ROUND(util,3) AS util, ROUND(setup_ws,3) AS setup_ws_ns, setup_corner, ROUND(hold_ws,3) AS hold_ws_ns, hold_corner, drc, lvs, xor, antenna, slew_viol, ROUND(power_w*1000,4) AS power_mw, flow_s, peak_gb, frozen, signoff FROM designs ORDER BY name",
     "rawQueryText": "SELECT name, family, cells, ff, die_um2, ROUND(util,3) AS util, ROUND(setup_ws,3) AS setup_ws_ns, setup_corner, ROUND(hold_ws,3) AS hold_ws_ns, hold_corner, drc, lvs, xor, antenna, slew_viol, ROUND(power_w*1000,4) AS power_mw, flow_s, peak_gb, frozen, signoff FROM designs ORDER BY name",
     "queryType": "table",
     "timeColumns": []
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "signoff"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
