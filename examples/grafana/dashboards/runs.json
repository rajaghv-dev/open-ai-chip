     "rawQueryText": "SELECT tag, design, changes, ROUND(setup_ws,3) AS setup_ws, ROUND(base_setup_ws,3) AS base_setup_ws, ROUND(d_setup_ws,3) AS d_setup_ws, ROUND(hold_ws,3) AS hold_ws, ROUND(d_hold_ws,4) AS d_hold_ws, cells, d_cells, wall_s, peak_gb FROM whatifs ORDER BY tag",
     "queryType": "table",
     "timeColumns": []
    }
   ],
   "fieldConfig": {
    "defaults": {},
