  {
   "id": 5,
   "title": "Recent jobs",
   "type": "table",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "chipdb"
   },
   "description": "Source: build/agent/jobs/*.log and build/agent/memory/runs.md.",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "chipdb"
     },
     "queryText": "SELECT time, result, design, ROUND(secs,1) AS secs, cmd, log FROM runs WHERE ts IS NOT NULL ORDER BY ts DESC LIMIT 40",
     "rawQueryText": "SELECT time, result, design, ROUND(secs,1) AS secs, cmd, log FROM runs WHERE ts IS NOT NULL ORDER BY ts DESC LIMIT 40",
     "queryType": "table",
     "timeColumns": []
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "result"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "PASS": {
            "color": "green",
            "index": 0
           },
           "FAIL": {
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "id": 6,
   "title": "Pass / fail per hour",
   "type": "timeseries",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "chipdb"
   },
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "chipdb"
     },
     "queryText": "SELECT (ts/3600)*3600 AS time, SUM(result='PASS') AS pass, SUM(result='FAIL') AS fail FROM runs WHERE ts IS NOT NULL GROUP BY 1 ORDER BY 1",
     "rawQueryText": "SELECT (ts/3600)*3600 AS time, SUM(result='PASS') AS pass, SUM(result='FAIL') AS fail FROM runs WHERE ts IS NOT NULL GROUP BY 1 ORDER BY 1",
     "queryType": "time series",
     "timeColumns": [
      "time"
     ]
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "pass"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       },
       {
        "id": "custom.drawStyle",
        "value": "bars"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "fail"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       },
       {
        "id": "custom.drawStyle",
        "value": "bars"
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "title": "Longest jobs (s)",
   "type": "barchart",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "chipdb"
   },
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "chipdb"
     },
     "queryText": "SELECT SUBSTR(cmd,1,40) || ' ' || SUBSTR(id,10,6) AS job, ROUND(secs,1) AS secs FROM runs WHERE secs IS NOT NULL ORDER BY secs DESC LIMIT 12",
     "rawQueryText": "SELECT SUBSTR(cmd,1,40) || ' ' || SUBSTR(id,10,6) AS job, ROUND(secs,1) AS secs FROM runs WHERE secs IS NOT NULL ORDER BY secs DESC LIMIT 12",
     "queryType": "table",
     "timeColumns": []
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "legend": {
     "showLegend": false
    },
    "xTickLabelRotation": 0,
    "showValue": "auto",
    "tooltip": {
     "mode": "single"
    }
   }
  },
  {
