   "id": 5,
   "title": "Tool-calling eval (overall)",
   "type": "table",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "chipdb"
   },
   "description": "Source: examples/hermes_desktop/eval_tools/results_summary_*.json.",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "chipdb"
     },
     "queryText": "SELECT backend, model, date, cases AS scored, passed, accuracy_pct FROM eval_scores WHERE grp='ALL' ORDER BY backend",
     "rawQueryText": "SELECT backend, model, date, cases AS scored, passed, accuracy_pct FROM eval_scores WHERE grp='ALL' ORDER BY backend",
     "queryType": "table",
     "timeColumns": []
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Eval accuracy by group (%)",
   "type": "barchart",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "chipdb"
   },
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "chipdb"
     },
     "queryText": "SELECT grp, MAX(CASE WHEN backend='direct' THEN accuracy_pct END) AS direct, MAX(CASE WHEN backend='hermes' THEN accuracy_pct END) AS hermes FROM eval_scores WHERE grp!='ALL' GROUP BY grp ORDER BY grp",
     "rawQueryText": "SELECT grp, MAX(CASE WHEN backend='direct' THEN accuracy_pct END) AS direct, MAX(CASE WHEN backend='hermes' THEN accuracy_pct END) AS hermes FROM eval_scores WHERE grp!='ALL' GROUP BY grp ORDER BY grp",
     "queryType": "table",
     "timeColumns": []
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "orientation": "auto",
    "legend": {
     "showLegend": true
    },
    "showValue": "auto"
   }
  },
  {
